{
  "version": 2,
  "builds": [
    {
      "src": "medinest/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "medinest/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "medinest.settings"
  }
}
